;; Taken from here: https://github.com/jtroo/kanata/discussions/1656

;; TODO: live reload with `lrld` action
;; TODO: layers similar to https://github.com/OneDeadKey/arsenik

(defcfg
  log-layer-changes no
  process-unmapped-keys yes
  ;; Without this, MX Master mice cursors are stuck in top left corner.
  ;; However, this also may cause Kanata to need a restart after bluetooth
  ;; reconnects. https://github.com/jtroo/kanata/issues/1390
  macos-dev-names-exclude 
    ("MX Master 2S"
     "MX Master 3S"))

(defvirtualkeys
  to-base (layer-switch base))

(defvar
  tot 220)

(deftemplate homerowmod (timeouttap timeouthold keytap keyhold)
  (tap-hold $timeouttap $timeouthold 
    (multi $keytap @.tp) 
    $keyhold))

(deftemplate homerowmodfiltered (timeouttap timeouthold keytap keyhold typinglist)
  (tap-hold-release-keys $timeouttap $timeouthold
    (multi $keytap @.tp)
    $keyhold
    $typinglist))

(defalias 
  .tp (switch () (multi (layer-switch typing) (on-idle 55 tap-vkey to-base)) break)
  capnav (tap-hold 200 200 esc (layer-toggle nav))
)

(defsrc)

(deflayermap (base)
  caps @capnav

  ;; HID media keys
  f1   brdn
  f2   brup
  f10  mute
  f11  vold
  f12  volu

  ;; Home row CAGS mods
  ;; Left hand
  a (t! homerowmod $tot 400 a lctl)
  s (t! homerowmod $tot 400 s lalt)
  d (t! homerowmod $tot 300 d lmet)
  f (t! homerowmod $tot 160 f lsft)
  ;; Right hand
  j (t! homerowmod $tot 160 j rsft)
  k (t! homerowmod $tot 300 k rmet)
  l (t! homerowmod $tot 400 l ralt)
  ; (t! homerowmod $tot 350 ; rctl)

  ;; Letter triggers
  q (multi q @.tp) w (multi w @.tp) e (multi e @.tp) r (multi r @.tp) t (multi t @.tp)
  y (multi y @.tp) u (multi u @.tp) i (multi i @.tp) o (multi o @.tp) p (multi p @.tp)
  g (multi g @.tp) h (multi h @.tp) z (multi z @.tp) x (multi x @.tp) c (multi c @.tp)
  v (multi v @.tp) b (multi b @.tp) n (multi n @.tp) m (multi m @.tp))

(deflayermap (typing)
  caps @capnav
  a a b b c c d d e e f f g g h h i i j j k k l l m m n n o o p p q q r r s s t t u u v v w w x x y y z z)

(deflayermap (nav)
  j left
  k down
  l right
  i up)

